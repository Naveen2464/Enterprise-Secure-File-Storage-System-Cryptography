# Local development defaults. Never commit real credentials or private keys.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./secure_storage.db
AZURE_KEY_VAULT_URL=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=encrypted-files
# Entra ID validation is intentionally not enabled until tenant/app registration is configured.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_AUDIENCE=
